# Supabase server-only integration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase browser integration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
APP_URL=
# Transactional email notifications (optional)
RESEND_API_KEY=
RESEND_FROM=
# Platform administrators (comma-separated Supabase auth user IDs)
SUPERADMIN_UIDS=
# Session and abuse controls
AUTH_MAX_SESSION_AGE_SECONDS=
AUTH_REQUIRE_VERIFIED_EMAIL=
AUTH_REQUIRE_MFA_ADMIN=
RATE_LIMIT_SHARED=
# Vercel Cron daily alerts; keep this secret server-side only
CRON_SECRET=

# Canonical production hostname (used by middleware to redirect non-canonical vercel.app hosts)
# Set this in Vercel Project Settings → Environment Variables for production
# Used by middleware (server-side) — NEXT_PUBLIC_ prefix works but not required.
NEXT_PUBLIC_CANONICAL_HOST=tienda-ss-ozkq.vercel.app
