# Supabase server-only integration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase browser integration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
APP_URL=
# Transactional email notifications (optional)
RESEND_API_KEY=
RESEND_FROM=
# Platform administrators (comma-separated Supabase auth user IDs)
SUPERADMIN_UIDS=
# Session and abuse controls
AUTH_MAX_SESSION_AGE_SECONDS=
AUTH_REQUIRE_VERIFIED_EMAIL=
# RECOMENDADO en producción: exige segundo factor a owner/admin/gerente/jefe.
# Antes de activarlo, cada administrador debe enrolar MFA en /workspace/security,
# o quedará bloqueado al iniciar sesión.
AUTH_REQUIRE_MFA_ADMIN=
# Fuerza el limitador de peticiones compartido basado en Supabase (recomendado en
# producción para que el límite sea global y no por instancia).
RATE_LIMIT_SHARED=
# Vercel Cron daily alerts + daily business summary; keep this secret server-side only
CRON_SECRET=
# Automatic daily summary and collection agent (WhatsApp): choose one provider.
# Meta WhatsApp Cloud API → WHATSAPP_PROVIDER=meta
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Plantilla aprobada de Meta para mensajes proactivos; el cuerpo debe aceptar {{1}}.
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=es
# Webhook entrante de Meta: tokens aleatorios + App Secret de Meta, solo server-side.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Twilio WhatsApp API → WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Content SID de una plantilla aprobada de WhatsApp con la variable {{1}}.
TWILIO_WHATSAPP_REMINDER_CONTENT_SID=
# Minutes after the tenant's configured hour when a missed summary is still delivered (hours, default 6).
DAILY_SUMMARY_WINDOW_HOURS=6

# Canonical production hostname (used by middleware to redirect non-canonical vercel.app hosts)
# Set this in Vercel Project Settings → Environment Variables for production
# Used by middleware (server-side) — NEXT_PUBLIC_ prefix works but not required.
NEXT_PUBLIC_CANONICAL_HOST=tienda-ss-ozkq.vercel.app
