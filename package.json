{
  "name": "tienda-ss",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:permissions && npm run test:migrations && node --import tsx --test tests/rate-limit.test.ts && node --import tsx --test tests/entitlements.test.ts && node --import tsx --test tests/health.test.ts && node --import tsx --test tests/middleware.test.ts && node --import tsx --test tests/api-authorization-matrix.test.ts && node --import tsx --test tests/invitations.test.ts",
    "test:all": "npm run test && npm run test:rules",
    "start": "next start",
    "lint": "eslint .",
    "migrate:user-roles": "tsx scripts/migrate-user-roles.ts",
    "backup:firestore": "./scripts/backup-firestore.sh",
    "check:production-env": "tsx scripts/check-production-env.ts",
    "emulators:start": "firebase emulators:start --only firestore",
    "test:permissions": "node --import tsx --test tests/permissions.test.ts",
    "test:migrations": "node --import tsx --test tests/migrate-user-roles.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "firebase-admin": "^13.0.0",
    "next": "15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.26.0",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "firebase-tools": "^14.16.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
